<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_retro_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Delivery"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_retro_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_delivery_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rb_delivered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivered"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_paused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paused / Holiday"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_not_delivered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not Delivered / Missed"
            android:textColor="@color/text_primary" />

    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Delivered Quantity">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_retro_qty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
